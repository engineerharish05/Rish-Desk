+private fun moveWidget(prefs: LauncherPrefs, index: Int, delta: Int) {
+    val ids = prefs.widgetIds.toMutableList()
+    val to = index + delta
+    if (index < 0 || to !in ids.indices) return
+    java.util.Collections.swap(ids, index, to)
+    prefs.updateWidgetIds(ids)
+}
