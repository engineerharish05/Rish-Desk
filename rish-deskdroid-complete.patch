+
+    if (showResize) {
+        val label = remember(info) { info.loadLabel(context.packageManager).toString() }
+        ResizeWidgetDialog(
+            label = label,
+            limits = limits,
+            size = size,
+            onChange = { prefs.updateWidgetSizes(prefs.widgetSizes + (id to limits.clamp(it))) },
+            onDismiss = { showResize = false },
+        )
+    }
+}
