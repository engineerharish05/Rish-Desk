+            WallpaperFit.FILL -> ContentScale.Crop
+            WallpaperFit.FIT -> ContentScale.Fit
+            WallpaperFit.STRETCH -> ContentScale.FillBounds
+        },
+        modifier = modifier,
+    )
+}
